# Free key from https://openrouteservice.org/dev/#/signup
# Free tier: 2000 directions/day, 40/minute. Routing is the ONLY thing this
# key is used for — geocoding goes to Photon, which needs no key.
ORS_API_KEY=

# Loop candidates requested per search. Each one is a routing call, so this is
# what sets how fast the daily quota burns: 12 candidates = ~166 searches/day.
CANDIDATE_SEEDS=12

# Routes shown per search.
MAX_RESULTS=5

# Throttle between routing calls, in seconds. 1.6s keeps 12 concurrent-ish
# requests under the 40/min ceiling.
ORS_MIN_INTERVAL_S=1.6
ORS_MAX_CONCURRENCY=4

# Place-name suggestions returned per query. Photon is asked for three times
# this many, because deduplicating collapses a lot of them.
GEOCODE_RESULTS=6

# A hard ceiling on routing calls per UTC day, under the free tier's 2000.
# A search reserves its whole cost up front and is refused before spending.
# 0 disables the guard.
ORS_DAILY_BUDGET=1800

# Where to fetch the POI database if it is not already on disk. Without this a
# fresh deployment starts with no database and falls back to Overpass, which is
# slow and unreliable — the POIs simply do not appear.
POI_DB_URL=https://github.com/flagthrow/doiamo/releases/download/poi-data-2026-09-02/pois.sqlite

# Reading a sentence into a search. The regex rules handle most of them for
# free; this model is only asked about the ones they give up on.
# Unset it and the feature still works — it just falls back to the rules.
ANTHROPIC_API_KEY=
INTENT_MODEL=claude-haiku-4-5

# Only needed if the key above is identity-linked rather than made inside a
# workspace — those keys do not say which workspace to bill, and the API
# refuses the call until you name it. Console > Settings > Workspaces; the id
# is in the URL and starts with wrkspc_.
ANTHROPIC_WORKSPACE_ID=
